{
  "manifest_version": 3,
  "name": "CVAT 3D Cuboid Helper",
  "version": "0.4.0",
  "description": "Tự fit cuboid theo cụm điểm (G, Ctrl+click), gom lại theo view 2D, giữ cuboid sát mặt đất, tự gom track ở frame sau trong CVAT 3D.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CVAT 3D Cuboid Helper",
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8080/*", "http://127.0.0.1:8080/*", "https://cvat.edufun.ai/*"],
      "js": ["extension/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:8080/*", "http://127.0.0.1:8080/*", "https://cvat.edufun.ai/*"],
      "js": ["cvat3d-cuboid-helper.user.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
